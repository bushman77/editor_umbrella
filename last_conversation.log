Replace [apps/llm/lib/llm/client.ex](/home/ubuntu/editor_umbrella/apps/llm/lib/llm/client.ex) with this:

```elixir
defmodule Llm.Client do
  @moduledoc false

  @base_url "http://127.0.0.1:8000"
  @request_options [
    receive_timeout: 1_200_000,
    connect_options: [timeout: 5_000]
  ]
  @chat_max_tokens 8_192
  @completion_max_predict 8_192

  def chat(messages) when is_list(messages) do
    with {:ok, body} <- chat_raw(messages) do
      {:ok, get_in(body, ["choices", Access.at(0), "message", "content"])}
    end
  end

  def chat_raw(messages) when is_list(messages) do
    response =
      Req.post!(
        [
          url: "#{@base_url}/v1/chat/completions",
          json: %{
            model: "local-model",
            messages: messages,
            stream: false,
            max_tokens: @chat_max_tokens
          }
        ] ++ @request_options
      )

    {:ok, response.body}
  rescue
    error -> {:error, error}
  end

  def complete(prompt) when is_binary(prompt) do
    response =
      Req.post!(
        [
          url: "#{@base_url}/completion",
          json: %{
            prompt: prompt,
            n_predict: @completion_max_predict
          }
        ] ++ @request_options
      )

    {:ok, Map.get(response.body, "content")}
  rescue
    error -> {:error, error}
  end
end
```

The main change is:

- `receive_timeout: 1_200_000`

That gives the LLM request up to 20 minutes before Req times out. I also kept the higher output caps aligned with the larger generations you were testing.

