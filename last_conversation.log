```elixir
defmodule Llm.ContextBuilder do
  @moduledoc """
  Selects project context for LLM requests.

  This module is responsible for deciding which files to include for a given
  question, then returning prompt-ready data that `Llm.Prompts` can format.
  """

  alias Llm.Prompts

  @default_extensions [".ex", ".exs", ".heex", ".js", ".ts", ".tsx", ".json", ".md"]
  @max_related_files 8
  @max_folder_files 24

  @type mode :: :file | :files | :folder
  @type prompt_file :: %{path: String.t(), content: String.t()}
  @type context :: %{
          mode: mode(),
          root_path: String.t(),
          question: String.t(),
          files: [prompt_file()],
          messages: Prompts.messages()
        }

  @spec build(String.t(), String.t() | nil, String.t()) :: {:ok, context()} | {:error, String.t()}
  def build(root_path, selected_file, question)
      when is_binary(root_path) and is_binary(question) do
    trimmed_question = String.trim(question)
    expanded_root = Path.expand(root_path)

    cond do
      trimmed_question == "" ->
        {:error, "Question cannot be empty."}

      not File.dir?(expanded_root) ->
        {:error, "Root path is not a directory: #{expanded_root}"}

      is_binary(selected_file) and File.regular?(selected_file) ->
        build_for_file(expanded_root, Path.expand(selected_file), trimmed_question)

      true ->
        build_for_folder(expanded_root, trimmed_question)
    end
  end

  @spec build_for_file(String.t(), String.t(), String.t()) :: {:ok, context()} | {:error, String.t()}
  def build_for_file(root_path, file_path, question)
      when is_binary(root_path) and is_binary(file_path) and is_binary(question) do
    with :ok <- ensure_within_root(file_path, root_path),
         {:ok, file_content} <- read_file(file_path) do
      files =
        file_path
        |> related_files_for_module(file_content, root_path)
        |> prepend_current_file(file_path, file_content)
        |> Enum.take(@max_related_files)

      {:ok,
       %{
         mode: context_mode(files),
         root_path: root_path,
         question: question,
         files: files,
         messages: build_messages(files, root_path, question)
       }}
    end
  end

  @spec build_for_folder(String.t(), String.t()) :: {:ok, context()} | {:error, String.t()}
  def build_for_folder(root_path, question) when is_binary(root_path) and is_binary(question) do
    if File.dir?(root_path) do
      files =
        root_path
        |> folder_files_for_prompt()
        |> Enum.take(@max_folder_files)

      {:ok,
       %{
         mode: :folder,
         root_path: root_path,
         question: question,
         files: files,
         messages: Prompts.editor_files_question(relativize_paths(files, root_path), question)
       }}
    else
      {:error, "Root path is not a directory: #{root_path}"}
    end
  end

  @spec related_files_for_module(String.t(), String.t(), String.t()) :: [prompt_file()]
  def related_files_for_module(file_path, file_content, root_path)
      when is_binary(file_path) and is_binary(file_content) and is_binary(root_path) do
    module_names =
      file_content
      |> extract_candidate_module_names()
      |> Enum.uniq()

    basename = Path.basename(file_path, Path.extname(file_path))

    candidate_paths =
      module_names
      |> Enum.flat_map(&search_paths_for_module_name(&1, root_path))
      |> Kernel.++(convention_related_paths(file_path, root_path, basename))
      |> Enum.uniq()
      |> Enum.reject(&(&1 == file_path))
      |> Enum.filter(&File.regular?/1)
      |> Enum.filter(&wanted_file?/1)

    candidate_paths
    |> Enum.map(&read_prompt_file/1)
    |> Enum.reject(&is_nil/1)
  end

  @spec folder_files_for_prompt(String.t()) :: [prompt_file()]
  def folder_files_for_prompt(root_path) when is_binary(root_path) do
    root_path
    |> list_files_recursive()
    |> Enum.filter(&wanted_file?/1)
    |> Enum.map(&read_prompt_file/1)
    |> Enum.reject(&is_nil/1)
  end

  @spec list_files_recursive(String.t()) :: [String.t()]
  def list_files_recursive(root_path) when is_binary(root_path) do
    do_list_files_recursive(Path.expand(root_path))
    |> Enum.sort()
  end

  defp do_list_files_recursive(path) do
    case File.ls(path) do
      {:ok, entries} ->
        Enum.flat_map(entries, fn name ->
          full_path = Path.join(path, name)

          case File.stat(full_path) do
            {:ok, %{type: :directory}} ->
              if skip_directory?(full_path) do
                []
              else
                do_list_files_recursive(full_path)
              end

            {:ok, %{type: :regular}} ->
              [full_path]

            _ ->
              []
          end
        end)

      {:error, _reason} ->
        []
    end
  end

  defp build_messages([file], _root_path, question) do
    Prompts.editor_file_question(file.path, file.content, question)
  end

  defp build_messages(files, root_path, question) do
    relative_files = relativize_paths(files, root_path)
    Prompts.editor_files_question(relative_files, question)
  end

  defp prepend_current_file(files, file_path, file_content) do
    [%{path: file_path, content: file_content} | files]
    |> Enum.uniq_by(& &1.path)
  end

  defp relativize_paths(files, root_path) do
    Enum.map(files, fn %{path: path, content: content} ->
      %{path: Path.relative_to(path, root_path), content: content}
    end)
  end

  defp context_mode([_single]), do: :file
  defp context_mode(files) when is_list(files), do: :files

  defp read_prompt_file(path) do
    case read_file(path) do
      {:ok, content} -> %{path: path, content: content}
      {:error, _reason} -> nil
    end
  end

  defp read_file(path) do
    case File.read(path) do
      {:ok, content} -> {:ok, Prompts.truncate_content(content, 12_000)}
      {:error, reason} -> {:error, "Could not read file #{path}: #{:file.format_error(reason)}"}
    end
  end

  defp ensure_within_root(path, root_path) do
    expanded_path = Path.expand(path)
    expanded_root = Path.expand(root_path)

    if String.starts_with?(expanded_path, expanded_root) do
      :ok
    else
      {:error, "Path is outside the selected root: #{expanded_path}"}
    end
  end

  defp extract_candidate_module_names(file_content) do
    case Code.string_to_quoted(file_content) do
      {:ok, ast} ->
        {_ast, names} =
          Macro.prewalk(ast, [], fn
            {:alias, _, alias_args} = node, acc ->
              {node, extract_alias_names(alias_args) ++ acc}

            {:defmodule, _, module_args} = node, acc ->
              {node, extract_defmodule_names(module_args) ++ acc}

            node, acc ->
              {node, acc}
          end)

        names

      {:error, _reason} ->
        []
    end
  end

  defp extract_alias_names(args) do
    case args do
      [{:__aliases__, _, parts}] ->
        [Enum.join(parts, ".")]

      [_meta, [{:__aliases__, _, parts}]] ->
        [Enum.join(parts, ".")]

      [_meta, aliases] when is_list(aliases) ->
        Enum.flat_map(aliases, fn
          {:__aliases__, _, parts} -> [Enum.join(parts, ".")]
          _ -> []
        end)

      _ ->
        []
    end
  end

  defp extract_defmodule_names(args) do
    case args do
      [{:__aliases__, _, parts}, _block] -> [Enum.join(parts, ".")]
      _ -> []
    end
  end

  defp search_paths_for_module_name(module_name, root_path) do
    short_name =
      module_name
      |> String.split(".")
      |> List.last()

    patterns =
      [module_name, short_name]
      |> Enum.filter(&is_binary/1)
      |> Enum.uniq()

    Enum.flat_map(patterns, fn pattern ->
      case System.cmd("rg", ["-l", pattern, root_path], stderr_to_stdout: true) do
        {output, 0} ->
          output
          |> String.split("\n", trim: true)
          |> Enum.map(&Path.expand/1)

        {_output, _status} ->
          []
      end
    end)
  end

  defp convention_related_paths(file_path, root_path, basename) do
    same_dir = Path.dirname(file_path)

    [
      Path.join(same_dir, "#{basename}.heex"),
      Path.join(same_dir, "#{basename}.html.heex"),
      Path.join(same_dir, "#{basename}_test.exs"),
      Path.join(root_path, "test/**/#{basename}_test.exs")
    ]
    |> Enum.flat_map(&expand_glob/1)
  end

  defp expand_glob(pattern) do
    Path.wildcard(pattern)
  end

  defp wanted_file?(path) do
    Path.extname(path) in @default_extensions and not skip_file?(path)
  end

  defp skip_directory?(path) do
    Path.basename(path) in [".git", "_build", "deps", "node_modules"]
  end

  defp skip_file?(path) do
    basename = Path.basename(path)
    String.starts_with?(basename, ".") and basename not in [".formatter.exs"]
  end
end
```

